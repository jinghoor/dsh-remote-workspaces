{
  "name": "@jinghoor/dsh-remote-workspaces",
  "version": "1.13.1",
  "description": "把另一台电脑的 DeepSeek Harness（DSH）工作区与会话并进本机侧边栏：内置公共中转，装好登录同一账号即可在多台设备间互连。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "files": [
    "lib/index.js",
    "lib/defaults.mjs",
    "lib/client.js",
    "lib/remote.mjs",
    "lib/ws.mjs",
    "lib/config.mjs",
    "lib/tunnel.mjs",
    "lib/dsh-relay.mjs",
    "README.md",
    "LICENSE",
    "cordis.patch.yml"
  ],
  "engines": {
    "dsh": ">=0.2.1-0"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "deepseek",
    "harness",
    "dsh-plugin",
    "dsh-plugins",
    "remote",
    "remote-control",
    "remote-workspace",
    "remote-workspaces",
    "multi-device",
    "sync",
    "tunnel",
    "relay",
    "nat-traversal",
    "self-hosted",
    "plugin"
  ],
  "license": "MIT",
  "author": "dsh-remote-workspaces authors",
  "repository": {
    "type": "git",
    "url": "https://github.com/jinghoor/dsh-remote-workspaces"
  },
  "homepage": "https://github.com/jinghoor/dsh-remote-workspaces#readme",
  "bugs": {
    "url": "https://github.com/jinghoor/dsh-remote-workspaces/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
